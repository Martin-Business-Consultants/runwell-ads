<%# locals: (statement:, show_work:) %>
<%# One month's ad fee: the month, the work (on the Ad fees page), spend, fee and why, its state and
    invoice, and what can be done next (draft, work out again, skip or restore). %>
<tr id="<%= dom_id(statement, :row) %>" data-filter-target="item">
  <td><%= statement.period_on.strftime("%b %Y") %></td>
  <% if show_work %>
    <td>
      <%= link_to statement.work.title, main_app.work_path(statement.work, tab: "plugin-ad_fees") %>
      <span class="muted small"><%= statement.client.name %></span>
    </td>
  <% end %>
  <td class="ad-fees-num"><%= money(statement.spend_cents) %></td>
  <td class="ad-fees-num"><strong><%= money(statement.fee_cents) %></strong></td>
  <td><span title="<%= statement.explanation %>"><%= statement.basis_name %></span></td>
  <td>
    <%= ad_fees_state_tag(statement) %>
    <% if statement.invoiced? %>
      <span class="small"><%= ad_fees_invoice_link(statement) %></span>
    <% end %>
    <% if statement.skip_reason.present? %>
      <span class="muted small"><%= statement.skip_reason %></span>
    <% end %>
    <% if statement.last_error.present? %>
      <span class="ad-fees-error small"><%= statement.last_error %></span>
    <% end %>
  </td>
  <td>
    <div class="button-row ad-fees-actions">
      <% if statement.invoiceable? %>
        <%= button_to "Draft invoice", ad_fees_statement_invoice_path(statement), class: "btn btn--secondary btn--sm" %>
      <% end %>
      <% if statement.recalculable? %>
        <%= button_to ad_fees_statement_recalculation_path(statement), class: "icon-button", title: "Work it out again from LuminAds" do %>
          <%= icon_tag "refresh" %><span class="visually-hidden">Work <%= statement.period_name %> out again</span>
        <% end %>
      <% end %>
      <% if statement.skippable? %>
        <%= button_to "Skip", ad_fees_statement_skip_path(statement), class: "btn btn--ghost btn--sm", title: "Don’t bill this month" %>
      <% end %>
      <% if statement.restorable? %>
        <%= button_to "Restore", ad_fees_statement_skip_path(statement), method: :delete, class: "btn btn--ghost btn--sm" %>
      <% end %>
    </div>
  </td>
</tr>
