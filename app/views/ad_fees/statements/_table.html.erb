<%# locals: (statements:, show_work:) %>
<%# Months of ad fees as a table. The Fee header carries the total of the rows shown, as a tooltip,
    for owners (ad_fees_amount_header). %>
<div class="table-wrap">
  <table class="table ad-fees-table">
    <thead>
      <tr>
        <th>Month</th>
        <% if show_work %>
          <th class="table__grow"><%= term(:work) %></th>
        <% end %>
        <th class="ad-fees-num">Ad spend</th>
        <th class="ad-fees-num"><%= ad_fees_amount_header("Fee", statements) %></th>
        <th>Why</th>
        <th>State</th>
        <th><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "ad_fees/statements/row", collection: statements, as: :statement, locals: { show_work: show_work } %>
    </tbody>
  </table>
</div>
