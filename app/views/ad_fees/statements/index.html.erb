<% @page_title = "Ad fees" %>
<%# Every month's ad fee across the work (AdFees::StatementsController), filtered by month and state. %>
<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Month", param: :period,
        options: [ [ "Every month", "" ] ] + @periods.map { [ it.strftime("%B %Y"), it.strftime("%Y-%m") ] },
        current: @period&.strftime("%Y-%m").to_s %>
  <%= render "layouts/shared/quick_filter", title: "State", param: :state,
        options: [ [ "Any state", "" ] ] + AdFeesHelper::AD_FEES_STATE_LABELS.map { |state, label| [ label, state ] },
        current: @state.to_s %>
<% end %>
<%= render "layouts/shared/index_toolbar" %>

<div class="stack ad-fees-page">
  <% if @setting.luminads_blocker %>
    <%= callout(tone: :attention) do %>
      <p><%= @setting.luminads_blocker %>.<% if can?(:manage_settings) %> <%= link_to "Open Ad fees settings", ad_fees_settings_path %>.<% end %></p>
    <% end %>
  <% end %>
  <% if @troubled.any? %>
    <%= callout(tone: :danger, title: "Couldn’t be worked out") do %>
      <ul class="ad-fees-troubles">
        <% @troubled.each do |plan| %>
          <%# herb:key plan.id %>
          <li><%= link_to plan.work.title, main_app.work_path(plan.work, tab: "plugin-ad_fees") %>: <%= plan.last_error %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <div class="ad-fees-run">
    <p class="muted small">
      Last month’s fees are worked out on day <%= @setting.run_on_day %> of each month<%= ", and each is drafted in QuickBooks, unsent" if @setting.draft_invoices %>.
      Default terms: <%= @setting.terms %>.
    </p>
    <%= form_with url: ad_fees_run_path, class: "ad-fees-run__form" do %>
      <%= date_input_tag "period", Date.current.prev_month.beginning_of_month, id: "ad_fees_run_period", aria: { label: "Any day of the month" } %>
      <button type="submit" class="btn btn--secondary btn--sm"><%= icon_tag "refresh" %> <span>Work out that month now</span></button>
    <% end %>
  </div>

  <% if @statements.any? %>
    <%= render "ad_fees/statements/table", statements: @statements.to_a, show_work: true %>
  <% else %>
    <%= render "layouts/shared/empty", text: "No ad fees yet. Set one up on a #{term(:work).downcase}’s Ad fees tab; each month’s shows here once it’s worked out.", action_text: nil, action_path: nil %>
  <% end %>
</div>
