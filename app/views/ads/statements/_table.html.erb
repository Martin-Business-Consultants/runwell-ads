<%# locals: (statements:, show_work:, unit: nil) %>
<%# Ad services' months as a table (ui :table): by service on the Ads page, by month on a work's
    tab. A running month adds where it's heading. The Fee header carries the total of the rows
    shown, as a tooltip, for owners (ads_amount_header). %>
<% projecting = statements.any?(&:partial?) %>
<%= ui :table, class: "ads-table" do %>
  <thead>
    <tr>
      <% if show_work %>
        <th data-grow><%= term(:work) %></th>
      <% else %>
        <th>Month</th>
      <% end %>
      <th data-align="end">Ad spend</th>
      <th data-align="end"><%= ads_amount_header("Fee", statements, unit: unit || (show_work ? "service" : "month")) %></th>
      <% if projecting %>
        <th data-align="end"><span title="The month at the pace so far">Heading for</span></th>
      <% end %>
      <th>Why</th>
      <th class="ads-state-cell">State</th>
      <th><span class="ui-sr-only">Actions</span></th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "ads/statements/row", collection: statements, as: :statement, locals: { show_work: show_work, projecting: projecting } %>
  </tbody>
<% end %>
