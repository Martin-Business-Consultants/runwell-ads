<% @page_title = "Ads" %>
<%= render "settings/header", current: :ads %>
<%# Settings › Plugins › Ads (Ads::SettingsController): the default fee and the run day, LuminAds, invoicing (off by default),
    and QuickBooks; the keys (Ads::ConnectionsController, browser only). %>
<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Default fee</h2>
      <p class="settings-section__description">
        The management fee each PPC service comes to, unless its own Ads tab says otherwise:
        now <%= @setting.terms %>.
      </p>
    </header>
    <%= form_with model: @setting, scope: :setting, url: ads_settings_path, method: :patch, class: "settings-form" do |form| %>
      <div class="ads-fields">
        <%= form.ui :field, :default_rule, label: "Rule" do %>
          <%= form.select :default_rule, Ads::Terms::RULES.map { |key, label| [ label, key ] } %>
        <% end %>
        <%= form.ui :field, :default_minimum_cents, label: "Minimum a month, or the flat fee" do %>
          <%= money_field form, :default_minimum_cents %>
        <% end %>
        <%= form.ui :field, :default_percent, label: "Share of ad spend (%)" do %>
          <%= form.number_field :default_percent, step: 0.01, min: 0, max: 100 %>
        <% end %>
      </div>
      <div class="ads-fields ads-fields--one">
        <%= form.ui :field, :run_on_day, label: "Last month is final on day", description: "Ad platforms settle a month’s spend for a few days after it ends; until this day it’s still read every night." do %>
          <%= form.number_field :run_on_day, min: 1, max: 28 %>
        <% end %>
      </div>
      <div><%= ui :button, type: :submit, content: "Save" %></div>
    <% end %>
  </section>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>LuminAds</h2>
      <p class="settings-section__description">
        Where spend comes from, read every night. Give your LuminAds address (with its workspace, such as https://you.luminads.com) and an API token
        made there; it only reads.
        <% if @setting.luminads_ready? %>Connected to <%= @setting.luminads_url %>.<% end %>
      </p>
    </header>
    <%= form_with model: @setting, scope: :luminads, url: ads_connection_path, method: :patch, class: "settings-form" do |form| %>
      <div class="ads-fields">
        <%= form.ui :field, :luminads_url, label: "Address" do %>
          <%= form.url_field :luminads_url, autocomplete: "off", placeholder: "https://you.luminads.com" %>
        <% end %>
        <%= form.ui :field, :luminads_token, label: "API token" do %>
          <%= secret_field form, :luminads_token, placeholder: @setting.luminads_token.present? ? "Saved; type to replace" : nil %>
        <% end %>
      </div>
      <div><%= ui :button, type: :submit, variant: :outline, content: "Save and test" %></div>
    <% end %>
  </section>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Invoicing</h2>
      <p class="settings-section__description">
        Off: Ads only keeps what each service costs. On: each month, once final, is drafted as an invoice in QuickBooks,
        unsent, with a task for someone to check it and send it from QuickBooks. Nothing is ever sent to a client from here.
      </p>
    </header>
    <%= form_with model: @setting, scope: :setting, url: ads_settings_path, method: :patch, class: "settings-form", namespace: "ads_invoicing" do |form| %>
      <%= switch_field form, :invoicing, label: "Draft invoices in QuickBooks", hint: "Needs QuickBooks connected below, a product or service for the line, and a customer on each service." %>
      <div class="ads-fields">
        <%= form.ui :field, :reviewer_id, label: "Drafts reviewed by", description: "Who gets each month’s task to check the draft and send it. A #{term(:work).downcase} may name someone else." do %>
          <%= form.select :reviewer_id, User.people.active.ordered.map { [ it.name, it.id ] }, { include_blank: "Nobody: each waits in Intake" } %>
        <% end %>
        <%= form.ui :field, :quickbooks_item_id, label: "QuickBooks product or service", description: "What the invoice line is for, as QuickBooks books it." do %>
          <% if @items.items.any? %>
            <%= form.select :quickbooks_item_id, @items.items.map { [ it["name"], it["id"] ] }, { include_blank: "Choose one" } %>
          <% else %>
            <p class="ads-quiet"><%= @items.error || "Connect QuickBooks below to choose one." %></p>
          <% end %>
        <% end %>
      </div>
      <div><%= ui :button, type: :submit, content: "Save" %></div>
    <% end %>
  </section>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>QuickBooks</h2>
      <p class="settings-section__description">
        Only for invoicing. Make an app at developer.intuit.com with the Accounting scope, add
        <code><%= ads_authorization_url %></code> as its redirect URI, then paste its keys here and sign in.
        <% if @connection.connected? %>
          Connected to <%= @connection.company_name || "QuickBooks" %><%= " (sandbox)" if @connection.sandbox? %>.
        <% end %>
      </p>
    </header>
    <% if @connection.last_error.present? %>
      <%= ui :alert, variant: :destructive, description: @connection.last_error %>
    <% end %>
    <%= form_with model: @connection, scope: :quickbooks, url: ads_connection_path, method: :patch, class: "settings-form" do |form| %>
      <div class="ads-fields">
        <%= form.ui :field, :client_id, label: "Client ID" do %>
          <%= form.text_field :client_id, autocomplete: "off" %>
        <% end %>
        <%= form.ui :field, :client_secret, label: "Client secret" do %>
          <%= secret_field form, :client_secret, placeholder: @connection.client_secret.present? ? "Saved; type to replace" : nil %>
        <% end %>
        <%= form.ui :field, :environment, label: "Company" do %>
          <%= form.select :environment, [ [ "Your real books", "production" ], [ "A sandbox company", "sandbox" ] ] %>
        <% end %>
      </div>
      <div><%= ui :button, type: :submit, variant: :outline, content: "Save" %></div>
    <% end %>
    <div class="ads-buttons">
      <% if @connection.configured? %>
        <%= button_to (@connection.connected? ? "Sign in to QuickBooks again" : "Sign in to QuickBooks"), ads_authorization_path, class: "ui-button", data: { variant: "default", size: "default", turbo: false } %>
      <% end %>
      <% if @connection.connected? %>
        <%= button_to "Disconnect", ads_connection_path, method: :delete, class: "ui-button", data: { variant: "ghost", size: "default" } %>
      <% end %>
    </div>
  </section>
</div>
