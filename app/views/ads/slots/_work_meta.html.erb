<%# locals: (work:) %>
<%# A PPC badge on the line under a tagged piece of work's title (the :work_meta slot); paused, it says so. %>
<% plan = work.ads_plan %>
<% if plan %>
  <%= ui :badge, content: plan.active ? plan.kind_name : "#{plan.kind_name}, paused", variant: plan.active ? :secondary : :outline, title: "An ad service: its cost is on the Ads tab" %>
<% end %>
